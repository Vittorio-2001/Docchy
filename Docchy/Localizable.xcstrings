    "Data di scadenza" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Expiration date"
          }
        }
      }
    },
    "Docchy e' il tuo assistente per gestire i documenti in modo semplice, senza account e senza abbonamenti." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Docchy is your assistant for managing documents simply, with no account and no subscriptions."
          }
        }
      }
    },
    "Docchy legge per te" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Docchy reads for you"
          }
        }
      }
    },
