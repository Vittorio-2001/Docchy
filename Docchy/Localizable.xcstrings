{
  "sourceLanguage" : "it",
  "strings" : {
    "\"%@\" scade il %@." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" is due on %@."
          }
        }
      }
    },
    "%@ · %lld pagine" : {
      "comment" : "A subtitle that shows the date the document was created, followed by the number of pages. The first argument is the formatted date of creation. The second argument is the number of pages in the document.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ · %2$lld pagine"
          }
        }
      }
    },
    "Annulla" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancel"
          }
        }
      }
    },
    "Apri il documento, tocca il menu \"...\" in alto e scegli \"Converti in\": puoi ottenere JPEG o PNG oltre al PDF originale. Il pulsante di condivisione invia invece direttamente il PDF." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open the document, tap the \"...\" menu at the top and choose \"Convert to\": you can get JPEG or PNG in addition to the original PDF. The share button sends the PDF directly instead."
          }
        }
      }
    },
    "Autenticazione non riuscita" : {
      "localizations" : {
